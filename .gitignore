# One ignore file for the whole project (backend = Laravel, frontend = Next.js).
# Laravel's small .gitignore files inside backend/storage and backend/bootstrap/cache
# stay where they are: they keep those empty folders in git.

# ---------- Common ----------
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
.fleet/
.nova/
.zed/
.claude/settings.local.json

# ---------- Backend (Laravel) ----------
backend/vendor/
backend/node_modules/
backend/.env
backend/.env.backup
backend/.env.production
backend/.phpactor.json
backend/.phpunit.result.cache
backend/.phpunit.cache/
backend/auth.json
backend/public/build/
backend/public/hot
backend/public/storage
backend/storage/*.key
backend/storage/pail/
backend/Homestead.json
backend/Homestead.yaml

# ---------- Frontend (Next.js) ----------
frontend/node_modules/
frontend/.pnp
frontend/.pnp.js
frontend/.yarn/install-state.gz
frontend/coverage/
frontend/.next/
frontend/out/
frontend/build/
frontend/.vercel/
frontend/**/.env*.local
frontend/**/*.pem
frontend/**/*.tsbuildinfo
frontend/next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
